database_url=sqlite:///./villagebank.db

# --- Lipila payments -------------------------------------------------------
# Sandbox by default. Set lipila_live_enabled=true AND switch the base URL to
# https://blz.lipila.io together — the app refuses to start if they disagree.
lipila_live_enabled=false
lipila_base_url=https://api.lipila.dev
lipila_api_key=
# Base64 of exactly 32 bytes, from the Lipila dashboard. Keep the outgoing key
# in _previous during a rotation so events signed just before the swap verify.
lipila_webhook_secret_current=
lipila_webhook_secret_previous=
lipila_timeout_seconds=15
lipila_webhook_replay_window_seconds=300
# Public origin Lipila must be able to reach to deliver webhooks.
lipila_callback_base_url=http://localhost:8000
# Where a card payer lands after the hosted payment page.
lipila_card_return_url=http://localhost:5173/?payment=return

# Payouts (withdrawals, loan disbursements). The endpoint paths below are
# inferred from Lipila's collections API, not verified against a live payout.
# Confirm them in the Lipila docs before switching this on.
lipila_disbursements_enabled=false
lipila_disbursement_mobile_money_path=/api/v1/disbursements/mobile-money
lipila_disbursement_bank_path=/api/v1/disbursements/bank
lipila_disbursement_status_path=/api/v1/disbursements/check-status

interest_compound_days=30
auth_secret_key=
auth_algorithm=HS256
access_token_expire_minutes=60
default_admin_email=
default_admin_password=
scheduler_timezone=UTC
smtp_host=
smtp_port=587
smtp_username=
smtp_password=
smtp_use_tls=true
smtp_from_email=
